APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL is required: the outbox relay claims rows with SKIP LOCKED, and concurrent workers share this database.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=consent
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=rabbitmq

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# MinIO, through the S3 driver. The bucket is created private by compose.yaml.
AWS_ACCESS_KEY_ID=sail
AWS_SECRET_ACCESS_KEY=password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=consent-imports
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

MINIO_ROOT_USER=sail
MINIO_ROOT_PASSWORD=password
FORWARD_MINIO_PORT=9000
FORWARD_MINIO_CONSOLE_PORT=9001

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=sail
RABBITMQ_PASSWORD=password
RABBITMQ_VHOST=sail
RABBITMQ_QUEUE=default
FORWARD_RABBITMQ_PORT=5672
FORWARD_RABBITMQ_DASHBOARD_PORT=15672

# Livewire stages uploads here before Filament moves them to BULK_IMPORT_DISK.
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

# Bulk import limits (see config/bulk-imports.php).
BULK_IMPORT_DISK=s3
BULK_IMPORT_MAX_FILE_SIZE_KB=524288
BULK_IMPORT_CHUNK_MAX_ROWS=10000
BULK_IMPORT_CHUNK_MAX_BYTES=5242880
BULK_IMPORT_MAX_ROW_BYTES=16384
BULK_IMPORT_RETENTION_DAYS=7

# RabbitMQ names for the bulk import pipeline. A routing key is also its message's type,
# so change one only while no outbox rows of that type are waiting.
BULK_IMPORT_EXCHANGE=consent.commands
BULK_IMPORT_PARSE_QUEUE=consent.parse
BULK_IMPORT_VALIDATE_QUEUE=consent.validate
BULK_IMPORT_ASSEMBLE_QUEUE=consent.assemble
BULK_IMPORT_PARSE_ROUTING_KEY=consent.parse.requested
BULK_IMPORT_VALIDATE_ROUTING_KEY=consent.chunk.validate
BULK_IMPORT_ASSEMBLE_ROUTING_KEY=consent.import.assemble

# Outbox relay. The lease on a claimed row is batch size x publish timeout + lease buffer.
OUTBOX_BATCH_SIZE=10
OUTBOX_PUBLISH_TIMEOUT_SECONDS=5
OUTBOX_LEASE_BUFFER_SECONDS=10
OUTBOX_BROKER_RETRY_SECONDS=5
OUTBOX_MAX_ATTEMPTS=10

VITE_APP_NAME="${APP_NAME}"
